# VMGT BOOKINGS - root .htaccess

# Never allow direct browsing of these folders / files
RedirectMatch 403 ^/(sql|includes|bin|docker|storage)(/|$)
RedirectMatch 403 ^/(Dockerfile|render\.yaml|\.dockerignore|README\.md)$

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable directory listing
Options -Indexes

# Block direct HTTP access to config.php (PHP include/require is unaffected)
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
